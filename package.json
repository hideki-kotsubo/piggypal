{
  "name": "flowtab",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "app",
    "api"
  ],
  "scripts": {
    "dev:app": "npm run dev -w app",
    "dev:api": "npm run dev -w api",
    "build": "npm run build -w app && npm run build -w api",
    "postinstall": "node scripts/link-capacitor-plugins.mjs",
    "test": "npm run test -w app",
    "changelog": "tsx scripts/build-changelog.mts",
    "social:screenshots": "tsx scripts/social/screenshots.mts",
    "social:compose": "tsx scripts/social/compose.mts",
    "social:from-changelog": "tsx scripts/social/from-changelog.mts",
    "social:publish": "tsx scripts/social/publish.mts"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "tsx": "^4.23.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.32.6": true
  }
}

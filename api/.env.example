# Copy to api/.env and fill in. Never commit the real .env (already
# gitignored, root .gitignore's bare ".env" pattern).

PORT=3002

# RS256 keypair for signAccessToken/getJwks (docs/05 D13, docs/39 step 4,
# jwt.ts). Generate with:
#   npm run -w api generate-jwt-keys
# then paste its two output lines below as-is (already \n-escaped).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# docs/05 auth routes (api/src/auth/routes.ts) — the same production
# Postgres db/schema.sql was verified against (docs/39 step 1), not a
# separate database. users/magic_links/refresh_tokens only; the
# sync/parse write paths (docs/03-04) will reuse this same connection
# once they're built.
DATABASE_URL=

# Where the emailed magic-link points (an app/ route, not this API
# directly — docs/05's verify flow needs client-side JS to read the
# clicking device's local user_id/device_id, which only the app has).
# Defaults to the Vite dev server if unset.
APP_BASE_URL=http://localhost:3001

# CORS for app/'s cross-subdomain fetch calls (credentials: true, so this
# can't be "*" — the browser rejects wildcard origin with credentials).
# Defaults to the Vite dev server if unset.
CORS_ORIGIN=http://localhost:3001

# Refresh-token cookie's Domain attribute (docs/05 D13). Leave unset in
# dev (scopes to the exact host only, correct for one-origin local
# testing); in production, set to the shared parent domain (e.g.
# .piggypal.codexbase.dev) so app.* and api-beta.* both receive it.
COOKIE_DOMAIN=

# Azure Communication Services connection string (docs/05 D15). Unset in
# dev — sendMagicLinkEmail (api/src/auth/email.ts) logs the link to the
# console instead of sending real email when this is empty.
AZURE_COMMUNICATION_CONNECTION_STRING=

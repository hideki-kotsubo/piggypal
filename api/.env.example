# Copy to api/.env and fill in. Never commit the real .env (already
# gitignored, root .gitignore's bare ".env" pattern).

PORT=3002

# RS256 keypair for signAccessToken/getJwks (docs/05 D13, docs/39 step 4,
# jwt.ts). Generate with:
#   npm run -w api generate-jwt-keys
# then paste its two output lines below as-is (already \n-escaped and
# double-quoted — keep the quotes).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# docs/05 auth routes (api/src/auth/routes.ts). In dev, the dev stack's
# own Postgres (deploy/docker-compose.dev.yaml's dev-postgres) — the same
# database the dev PowerSync replicates from, so users/refresh_tokens
# written here are visible to sync. Values come from deploy/.env.dev.
#
# DATABASE_HOST/PORT depend on where the api runs:
#   - on the docker host:                    localhost / 5433 (DEV_PG_PORT)
#   - inside a container joined to
#     docker-stack_backend (e.g. the
#     dev workspace):                        flowtab-dev-postgres / 5432
DATABASE_HOST=flowtab-dev-postgres
DATABASE_PORT=5432
DATABASE_USER=flowtab
# POSTGRES_PASSWORD from deploy/.env.dev, as-is (no URL-encoding needed).
DATABASE_PASSWORD=REPLACE_ME
DATABASE_NAME=flowtab

# Alternative: one full connection URL. If set, it overrides every
# DATABASE_* var above (production's docker-compose.yaml sets this).
# Password must be URL-encoded here.
#DATABASE_URL=postgres://user:password@host:5432/dbname

# Where the emailed magic-link points (an app/ route, not this API
# directly — docs/05's verify flow needs client-side JS to read the
# clicking device's local user_id/device_id, which only the app has).
# Defaults to the Vite dev server if unset.
APP_BASE_URL=http://localhost:3001

# CORS for app/'s cross-subdomain fetch calls (credentials: true, so this
# can't be "*" — the browser rejects wildcard origin with credentials).
# Defaults to the Vite dev server if unset.
CORS_ORIGIN=http://localhost:3001

# Refresh-token cookie's Domain attribute (docs/05 D13). Leave unset in
# dev (scopes to the exact host only, correct for one-origin local
# testing); in production, set to the shared parent domain (e.g.
# .flowtab.codexbase.dev) so app.* and api-beta.* both receive it.
COOKIE_DOMAIN=

# SMTP2GO API key (docs/05 D15). Unset in dev — sendMagicLinkEmail
# (api/src/auth/email.ts) logs the link to the console instead of sending
# real email when this is empty. Find/create one at smtp2go.com under
# Settings > API Keys.
SMTP2GO_API_KEY=

# The verified sender address email is sent from — required once
# SMTP2GO_API_KEY is set, ignored otherwise. Needs a verified sender or
# domain under smtp2go.com's Sender Domains/Verified Senders page first —
# unlike Resend there's no zero-setup onboarding domain, so this can't be
# left as a placeholder once the API key is real.
SMTP2GO_FROM_ADDRESS=

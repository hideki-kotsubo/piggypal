# Copy to app/.env and fill in. Never commit the real .env (already
# gitignored, root .gitignore's bare ".env" pattern). Vite loads .env <
# .env.local < .env.[mode] < .env.[mode].local, increasing priority — an
# .env.local (also gitignored) is the right place for a personal
# machine-specific override without touching this file's committed
# defaults or the real .env's production values.

# docs/28 — anonymous WebSocket signaling relay for remote P2P device
# pairing when both devices aren't in the same room. Defaults to the api/
# dev server if unset (api/src/relay.ts, mounted at /relay).
VITE_RELAY_WS_URL=ws://localhost:3000/relay

# docs/41-43 — base URL for every /api/auth/* and /api/sync/* call
# (app/src/lib/auth.ts). Defaults to the api/ dev server if unset.
VITE_API_BASE_URL=http://localhost:3000

# docs/43 — PowerSync Service's own public endpoint (app/src/lib/
# connector.ts), distinct from VITE_API_BASE_URL above even though both
# may sit behind the same reverse proxy in production. Unset in dev
# (and in production, as of 2026-08-22 — docs/39 open question #4: no
# subdomain has been decided, and no production JWT keypair is deployed
# behind /.well-known/jwks.json for PowerSync to verify against yet)
# falls back to connector.ts's own http://localhost:8080 default, which
# only resolves against a PowerSync Service actually running locally —
# otherwise every sync attempt fails with ERR_CONNECTION_REFUSED. That
# failure is expected and independent of sign-in/sync upload, which
# don't need this at all.
VITE_POWERSYNC_URL=

# Copy to .env on the deploy host and fill in real values. Never commit the
# real .env — deploy/.gitignore covers it (same pattern as api/.env, app/.env).

# ==================== Source Postgres (docs/39 step 1) =====================
# Confirmed working 2026-08-22: real Postgres container named `postgres`,
# on the `docker-stack_backend` network (docker-compose.yaml joins it),
# schema applied, wal_level=logical confirmed, piggypal role has
# REPLICATION, and `CREATE PUBLICATION powersync FOR ALL TABLES;` has
# been run against the piggypal database (required — PowerSync doesn't
# create this itself, and replication fails with PSYNC_S1141 without it).
# Host is the container name, not localhost — resolved via that shared
# network's DNS, not a published host port.
#
# REAL GOTCHA (see README.md's "Real problems hit and fixed" #4):
# PowerSync's Postgres client (pgwire) failed to authenticate against
# this role over scram-sha-256 even with a confirmed-correct password —
# a real client-library incompatibility, not a config mistake (verified
# with a throwaway `psql` container on the same network path, which
# authenticated fine). Workaround: piggypal's pg_hba.conf rule was
# switched to `md5` specifically (ahead of the scram-sha-256 catch-all),
# and its password re-set under `password_encryption=md5` so the stored
# hash actually matches. If your role still uses scram-sha-256, expect
# the same "password authentication failed" error and the same fix.
PS_DATA_SOURCE_URI=postgres://piggypal:REPLACE_ME@postgres:5432/piggypal

# ==================== Sync-bucket storage ===================================
# Same Postgres as above by default (see docker-compose.yaml's comment) —
# PowerSync creates its own `powersync` schema there. Point elsewhere only
# if you deliberately want bucket storage on a separate instance.
PS_STORAGE_SOURCE_URI=postgres://piggypal:REPLACE_ME@postgres:5432/piggypal

# 'verify-full' (default, recommended) | 'verify-ca' | 'disable'
# This is a plain self-hosted container-to-container connection over an
# internal Docker network with no TLS configured on the Postgres side
# (the default for a bare `postgres` image) — 'disable' is correct here,
# not a shortcut. Only switch to verify-full/verify-ca if TLS is actually
# set up on that Postgres instance.
PS_DB_SSLMODE=disable

# ==================== Client auth (docs/05 D13) =============================
# Must resolve publicly over HTTPS — PowerSync fetches this itself, it's
# not just informational. The route's code is real (docs/40) but has no
# production keypair deployed yet, so it currently 500s — PowerSync
# itself starts and stays healthy regardless (confirmed 2026-08-22); this
# only blocks real client authentication, not the service coming up.
PS_JWKS_URL=https://api-beta.piggypal.codexbase.dev/.well-known/jwks.json

# ==================== PowerSync's own admin API =============================
# Generate with: openssl rand -hex 32
PS_ADMIN_API_TOKEN=REPLACE_ME

# ==================== Network ================================================
# Host port PowerSync binds to; reverse-proxy this via nginx-proxy-manager
# the same way app.piggypal.codexbase.dev / api-beta.piggypal.codexbase.dev
# already are (docs/39 open question #4 — subdomain not yet decided). The
# number itself is arbitrary since nothing hits it directly once proxied —
# 8080 collided with something else already running on the docker-stack
# host (2026-08-21, "port is already allocated"); pick whatever's actually
# free there (check with `docker ps --format "table {{.Names}}\t{{.Ports}}"`).
PS_PORT=8090

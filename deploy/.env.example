# Copy to deploy/.env and fill in real values:
#   cp .env.example .env
# Never commit the real .env — the root .gitignore's bare ".env" pattern
# covers it, same as api/.env and app/.env.

# ==================== Postgres ==============================================
# Used to build DATABASE_URL / PS_DATA_SOURCE_URI / PS_STORAGE_SOURCE_URI
# below automatically — only set the password here, not the full URLs.
POSTGRES_DB=flowtab
POSTGRES_USER=flowtab
POSTGRES_PASSWORD=REPLACE_ME

# ==================== api (Node/Express backend) =============================
API_PORT=3002

# RS256 keypair for signAccessToken/getJwks (docs/05 D13, api/jwt.ts).
# Generate with:
#   npm run -w api generate-jwt-keys
# then paste its two output lines below as-is (already \n-escaped).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Where the emailed magic-link points, and who's allowed to call the api
# cross-origin with credentials. Point these at wherever app/'s built
# static files (app/dist) actually get served from — see the root
# website/app.conf nginx configs for the pattern.
APP_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Refresh-token cookie's Domain attribute (docs/05 D13). Leave unset for a
# single-origin deploy; set to a shared parent domain (e.g.
# .flowtab.codexbase.dev) once app.* and api.* are on different subdomains.
COOKIE_DOMAIN=

# SMTP2GO API key (docs/05 D15). Leave unset to log magic links to the
# `api` container's logs instead of sending real email — fine for a first
# smoke test, not for real users. SMTP2GO_FROM_ADDRESS needs a verified
# sender/domain under smtp2go.com first — no zero-setup onboarding domain
# like Resend had.
SMTP2GO_API_KEY=
SMTP2GO_FROM_ADDRESS=

# ==================== PowerSync Service ======================================
PS_PORT=8090

# Only needed if PowerSync can't reach the api container directly (see
# docker-compose.yaml's comment) — leave unset to use the internal
# container-to-container default.
PS_JWKS_URL=

# Generate with: openssl rand -hex 32
PS_ADMIN_API_TOKEN=REPLACE_ME

# Copy to deploy/.env.dev and fill in — used only by docker-compose.dev.yaml:
#   cp .env.dev.example .env.dev
#   docker compose -f docker-compose.dev.yaml --env-file .env.dev up -d
# Never commit the real .env.dev (root .gitignore's ".env.*" covers it).

# ==================== Postgres (dev) ========================================
POSTGRES_DB=flowtab
POSTGRES_USER=flowtab
POSTGRES_PASSWORD=REPLACE_ME
# Host PowerSync uses to reach this Postgres — the dev container's own name,
# never the bare "postgres" alias (see docker-compose.dev.yaml's header).
POSTGRES_HOST=flowtab-dev-postgres

# Host port for the dev api (running outside Docker) to reach Postgres.
# api/.env then uses: DATABASE_URL=postgres://flowtab:<password>@<host>:5433/flowtab
# DEV_PG_BIND defaults to loopback; set it to the host's private IP if the
# dev api runs somewhere that can't reach the host's 127.0.0.1.
DEV_PG_BIND=127.0.0.1
DEV_PG_PORT=5433

# ==================== PowerSync (dev) =======================================
PS_PORT=8090
# The dev api's JWKS (npm run dev:api, proxied as api-beta).
PS_JWKS_URL=https://api-beta.flowtab.codexbase.dev/.well-known/jwks.json
# Generate with: openssl rand -hex 32 — not the same value as production's.
PS_ADMIN_API_TOKEN=
